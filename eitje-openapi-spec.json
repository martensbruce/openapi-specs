  "paths": {
    "/availability_shifts": {
      "get": {
        "operationId": "getAvailabilityShifts",
        "summary": "List availability shifts",
        "description": "Returns availability shifts for employees. Tracks whether employees are available, unavailable, or partly unavailable.",
        "tags": [
          "Availability Shifts"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/StartDate"
          },
          {
            "$ref": "#/components/parameters/EndDate"
          },
          {
            "$ref": "#/components/parameters/DateFilterType"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AvailabilityShift"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
