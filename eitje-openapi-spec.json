  "info": {
    "title": "Eitje Open API",
    "description": "Eitje is a scheduling software platform that provides endpoints for managing workforce data across organizations with multiple locations and teams.",
    "version": "1.0.0",
    "contact": {
      "name": "Eitje",
      "url": "https://www.eitje.app"
    }
  },
  "servers": [
    {
      "url": "https://open-api.eitje.app/open_api",
      "description": "Production"
    },
    {
      "url": "https://open-api-test.eitje.app/open_api",
      "description": "Test"
    }
  ],
  "security": [
    {
      "partnerAuth": [],
      "partnerPassword": [],
      "apiAuth": [],
      "apiPassword": []
