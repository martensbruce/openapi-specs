  "components": {
    "securitySchemes": {
      "partnerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Partner-Username",
        "description": "Partner username credential. Must be used together with Partner-Password."
      },
      "partnerPassword": {
        "type": "apiKey",
        "in": "header",
        "name": "Partner-Password",
        "description": "Partner password credential."
      },
      "apiAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Api-Username",
        "description": "API username credential. Must be used together with Api-Password."
      },
      "apiPassword": {
        "type": "apiKey",
        "in": "header",
        "name": "Api-Password",
        "description": "API password credential."
      }
    },
    "parameters": {
      "StartDate": {
        "name": "start_date",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2024-01-01"
        },
        "description": "Start date for filtering (YYYY-MM-DD for resource_date, ISO8601 for updated)"
      },
      "EndDate": {
        "name": "end_date",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2024-01-31"
        },
        "description": "End date for filtering (YYYY-MM-DD for resource_date, ISO8601 for updated)"
      },
      "DateFilterType": {
        "name": "date_filter_type",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "resource_date",
            "updated"
          ],
          "default": "resource_date"
        },
        "description": "Filter by resource date or last updated timestamp. Defaults to resource_date."
      }
    },
    "schemas": {
      "NameIdRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "IdRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      },
      "AvailabilityShift": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "remarks": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "partly_unavailable"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/NameIdRef"
          },
          "start_datetime": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Only present when status is partly_unavailable"
          },
          "end_datetime": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Only present when status is partly_unavailable"
          }
        }
      },
      "CheckIn": {
        "type": "object",
